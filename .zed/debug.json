// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
//
// IMPORTANT: The binary requires X11 (DISPLAY) to run.
//
// To test on the host outside the container:
//   cd pc/build/bin && ./AnimalCrossing --verbose
[
    {
        "adapter": "GDB",
        "label": "Launch AnimalCrossing (container - Fedora 44 64-bit)",
        "program": "$ZED_WORKTREE_ROOT/pc/build/bin/AnimalCrossing",
        "cwd": "$ZED_WORKTREE_ROOT/pc/build/bin",
        "arguments": ["--verbose"],
        "env": {
            "DISPLAY": "${env:DISPLAY}",
            "XAUTHORITY": "${env:XAUTHORITY}",
            "GTK_MODULES": ""
        },
        "request": "launch",
        "stopOnEntry": true
    },
    {
        "adapter": "GDB",
        "label": "Launch AnimalCrossing (host - verbose)",
        "program": "$ZED_WORKTREE_ROOT/pc/build/bin/AnimalCrossing",
        "cwd": "$ZED_WORKTREE_ROOT/pc/build/bin",
        "arguments": ["--verbose"],
        "request": "launch"
    },
    {
        "adapter": "GDB",
        "label": "Launch AnimalCrossing (host - release)",
        "program": "$ZED_WORKTREE_ROOT/pc/build/bin/AnimalCrossing",
        "cwd": "$ZED_WORKTREE_ROOT/pc/build/bin",
        "request": "launch"
    }
]
