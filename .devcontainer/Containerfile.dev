# Containerfile.dev — Dev container for the ACGC PC port
#
# Installs all build dependencies + GDB for debugging.  The project source
# is mounted at runtime by the dev container, NOT baked into the image.
#
# After entering the container, build with:
#   cd pc && mkdir -p build && cd build
#   cmake ..
#   make -j$(nproc)
#
# Then run:
#   cd pc/build/bin
#   ./AnimalCrossing --verbose
#   gdb --args ./AnimalCrossing --verbose

FROM fedora:44

RUN dnf install -y \
    gcc gcc-c++ cmake make ninja-build \
    glibc-devel libstdc++-devel libgcc libatomic \
    libX11-devel libXext-devel libXrandr-devel \
    libXcursor-devel libXi-devel libXinerama-devel \
    libXxf86vm-devel \
    clangd \
    xauth xdpyinfo xclock \
    which \
    file \
    @development-tools \
    clang-tools-extra \
    strace \
    gdb \
    lldb \
    alsa-lib-devel pulseaudio-libs-devel \
    sdl2-compat-devel mesa-libGL-devel mesa-libEGL-devel mesa-dri-drivers \
    curl python3 git \
    && \
    echo 'Testing 64-bit C compile...' && \
    echo 'int main(){return 0;}' | gcc -x c - -o /tmp/test64 && \
    /tmp/test64 && echo '64-bit works!' && \
    dnf clean all

WORKDIR /workspace
